# Copy to .env and fill in. The key is only ever read by the local proxy in server/,
# never shipped to the browser.
OPENAI_API_KEY=sk-...
PORT=8787

# "Add workspace" opens your desktop's folder chooser through the proxy. Set this to off if the
# proxy runs on a different machine from your browser, so it does not open a window you cannot see.
# MNEMONIC_FOLDER_DIALOG=off
